# Django secret key used for cryptographic signing
SECRET_KEY=change-me

# Toggle Django debug mode: True for development, False for production
DEBUG=True

# Comma-separated list of allowed hosts (e.g. localhost,127.0.0.1)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database connection string, e.g. postgres://USER:PASSWORD@HOST:PORT/NAME
# Leave blank to fall back to the default SQLite database
DATABASE_URL=
