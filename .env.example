# Django secret key used for cryptographic signing
SECRET_KEY=change-me

# Toggle Django debug mode: True for development, False for production
DEBUG=True

# Comma-separated list of allowed hosts (e.g. localhost,127.0.0.1)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database connection string, e.g. postgres://USER:PASSWORD@HOST:PORT/NAME
# Leave blank to fall back to the default SQLite database
DATABASE_URL=

# Supabase Postgres example (replace [YOUR-PASSWORD])
# postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase configuration for the frontend (Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase configuration copied from the Supabase dashboard (Next.js format)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key
